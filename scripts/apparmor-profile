# LNTA AppArmor Profile
# Purpose: Allow unprivileged user namespaces for bubblewrap sandboxing
# Install: /etc/apparmor.d/lnta
# Load:  apparmor_parser -r /etc/apparmor.d/lnta
# Remove: apparmor_parser -R /etc/apparmor.d/lnta

abi <abi/4.0>,
include <tunables/global>

profile lnta-bwrap flags=(unconfined) {
  userns,

  # Read-only system mounts
  / r,
  /usr/** r,
  /bin/** r,
  /lib/** r,
  /lib64/** r,
  /etc/** r,
  /proc/** r,
  /sys/** r,
  /dev/** r,
  /run/** r,

  # Read-write tmpfs
  /tmp/** rw,
  /var/tmp/** rw,

  # Mask secret directories (read access only; they appear empty inside sandbox anyway)
  @{HOME}/.ssh/** r,
  @{HOME}/.gnupg/** r,
  @{HOME}/.aws/** r,
  @{HOME}/.kube/** r,
  @{HOME}/.config/lnta/** r,

  # Site-specific additions
  include if exists <local/lnta-bwrap>
}